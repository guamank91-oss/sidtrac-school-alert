APP_NAME=SIDTRAC API
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_HOURS=8

# Cambia "postgres" por la contraseña que pusiste al instalar PostgreSQL 16
DATABASE_URL=postgresql+asyncpg://postgres:TU_PASSWORD@127.0.0.1:5432/sidtrac

CORS_ORIGINS=http://localhost:5173
OPENROUTER_API_KEY=
RESEND_API_KEY=

# Fase 0+ demo (activar módulo DECE)
AI_PROVIDER_ENABLED=true
CHROMA_COLLECTION=sidtrac_documents_v2
STUDENT_REF_HMAC_SECRET=change-me-student-ref
FEATURE_DECE_CASES=true
FEATURE_ACTION_PLANS=true
